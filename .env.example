# Meta Model API key from https://dev.meta.ai/platform
MODEL_API_KEY=
# Optional: run the pipeline against canned responses, no API calls, no cost
VID2SIM_MOCK=0
# Optional, open-weight bonus: verify pass on Muse Spark Open via a partner endpoint
VERIFY_BASE_URL=
VERIFY_API_KEY=
VERIFY_MODEL=
# Parallel Muse Image / code-generation requests (default 4)
VID2SIM_PARALLEL=4
# Unity editor used by the Muse Code compile gate and the dashboard's APK build (set VID2SIM_COMPILE_GATE=0 to skip the gate)
UNITY_EXE=/Applications/Unity/Hub/Editor/6000.3.21f1/Unity.app/Contents/MacOS/Unity
